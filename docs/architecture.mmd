flowchart TD
  User[Human / automation] --> API[Versioned HTTP API]
  User --> CLI[helix CLI]
  API --> Runtime[Helix Runtime]
  CLI --> Runtime
  Runtime --> Recall[Fast Cached Recall]
  Recall --> Cache[TTL/LRU MemoryCache]
  Cache --> Search[Bounded Hybrid Search]
  Search --> Indexes[SQLite indexes + FTS5 candidates]
  Indexes --> Router[Adaptive Router]
  Runtime --> Router
  Router --> Planner[Validated Task DAG]
  Router --> Agents[Agent Registry + Health + Reputation]
  Runtime --> Scheduler[Lease Scheduler + Durable Leases]
  Runtime --> Policy[Default-deny Policy + RBAC + Approvals]
  Runtime --> Provider[Provider Interface]
  Runtime --> Events[Durable Event Store]
  Events --> Replay[Replay + Atomic Snapshots]
  Runtime --> Memory[MemoryBackend]
  Memory --> SQLite[SqliteMemoryStore
WAL + transactions + indexes]
  Memory --> JSONL[MemoryStore
M9 compatibility]
  Memory --> ACL[Namespace ACL + Provenance]
  Memory --> Compaction[Compaction + VACUUM + JSONL migration]
  Runtime --> Learning[Persistent Learning Engine]
  Learning --> Queue[Bounded Async Learning Queue]
  Queue --> Batch[Batch outcome persistence]
  Batch --> Memory
  Learning --> Outcome[Outcome Sanitization + Idempotency]
  Outcome --> Memory
  Learning --> Bonus[Bounded Learning Bonus <= 10%]
  Bonus --> Router
  Runtime --> Telemetry[Traces + Metrics + Logs]
  Runtime --> SandboxManager[SandboxManager]
  SandboxManager --> SandboxPolicy[Canonical Paths + Exec Allowlist + Env Filter]
  SandboxManager --> Local[LocalSandbox
Best-effort controls]
  SandboxManager --> Docker[DockerSandbox
Kernel/container controls]
  Local --> Execution[Bounded Command Execution]
  Docker --> Execution
  Execution --> Audit[SandboxAuditLog]
  Audit --> Events
  Runtime --> Knowledge[Local Knowledge Graph]
  Policy -. guarded boundary .-> Tools[Tool / MCP adapters]
  Policy -. plugin permissions .-> Plugins[Trusted Plugin Registry]
  Provider --> Models[Provider / Model Discovery]
  Scheduler -. signed protocol foundation .-> Nodes[Remote Helix nodes]
  Runtime --> Dashboard[Read-only Dashboard]
