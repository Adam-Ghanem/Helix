flowchart TD
  User[Human / automation] --> API[Versioned HTTP API]
  User --> CLI[helix CLI]
  API --> Runtime[Helix Runtime]
  CLI --> Runtime

  Runtime --> Goal[Goal model]
  Goal --> Analysis[Deterministic goal analysis]
  Analysis --> Decomposer[Bounded category-aware decomposition]
  Decomposer --> IntelligencePlanner[Intelligence Planner]
  IntelligencePlanner --> Plan[Typed Execution Plan]
  Plan --> Validator[Plan Validator]
  Validator -->|valid + authorized| Selector[Capability-first agent selector]
  Validator -->|invalid or unauthorized| Reject[Typed rejection / approval required]

  Selector --> SwarmManager[M13 DynamicSwarmManager]
  SwarmManager --> Formation[Bounded team formation]
  Formation --> Roles[Multi-role members]
  Formation --> Topology[Adaptive topology rules]
  Topology -->|parallelism| Parallel[Parallel / mesh]
  Topology -->|dependency| Pipeline[Pipeline / hierarchical]
  Topology -->|risk or failure| SecurityTopology[Coordinator + security review]
  SwarmManager --> Coordinator[Deterministic coordinator]
  Coordinator --> Delegation[Direct / role / capability / swarm delegation]
  Delegation --> Scheduler[Existing Lease Scheduler + durable leases]
  Delegation --> Handoff[Bounded handoff history + loop detection]
  Handoff --> Delegation
  SwarmManager --> Scale[Bounded scale up / scale down]
  Scale --> AgentRegistry[Existing Agent Registry + capacity]
  SwarmManager --> Health[SwarmHealthMonitor]
  Health --> Rebalance[Deterministic rebalancing]
  Rebalance --> Scheduler
  Health --> Topology

  Runtime --> Federation[M14 FederationCoordinator]
  Federation --> Nodes[NodeRegistry]
  Nodes --> Membership[Node identity / role / capability / trust]
  Nodes --> Heartbeat[Heartbeat + stale-node detection]
  Heartbeat --> NodeHealth[Health / load / latency]
  Federation --> FederationRouter[Capability-safe federation router]
  FederationRouter --> NodeHealth
  FederationRouter --> LocalNode[Local Helix node]
  FederationRouter --> RemoteNode[Healthy remote node]
  Federation -->|remote authorized| Signer[Injected signer / verifier]
  Signer --> Envelope[Versioned signed message envelope]
  Envelope --> Replay[Timestamp / TTL / schema / replay checks]
  Replay --> Transport[Replaceable federation transport]
  Transport --> RemoteCoordinator[Remote FederationCoordinator]
  RemoteCoordinator --> RemoteLease[Distributed lease + fencing token]
  RemoteLease --> RemoteWorkers[Existing remote worker execution seam]
  RemoteWorkers --> RemoteEvidence[Signed accept / completion / failure evidence]
  RemoteEvidence --> Transport
  Transport --> Correlation[Correlation / trace / authorization validation]
  Correlation --> Federation
  Federation --> Recovery[Bounded expiry / recovery / reassignment]
  Recovery --> FederationRouter
  Federation --> FederatedSwarm[Federated swarm membership]
  FederatedSwarm --> FederatedAggregate[Explicit result aggregation]
  FederatedAggregate --> Federation

  Scheduler --> Workers[Existing workers / task execution]
  Workers --> SandboxManager[Existing SandboxManager]
  SandboxManager --> SandboxPolicy[Canonical paths + exec allowlist + env filter]
  SandboxPolicy --> Local[LocalSandbox best-effort controls]
  SandboxPolicy --> Docker[DockerSandbox kernel/container controls]
  Local --> Execution[Bounded command execution]
  Docker --> Execution
  Execution --> StepEvidence[Sanitized step evidence]
  StepEvidence --> Evaluator[Evidence-based evaluator]
  Evaluator --> Aggregate[SwarmResultAggregator]
  Aggregate --> Consensus[Application-level review consensus]
  Consensus --> Complete[COMPLETED / result]
  Evaluator -->|failure / timeout| SwarmRecovery[Bounded failure recovery]
  SwarmRecovery -->|retry or handoff| Delegation
  SwarmRecovery -->|replan when limits remain| Replanner[Bounded Intelligence Replanner]
  Replanner --> Selector
  SwarmRecovery -->|no alternative or limit reached| Failed[FAILED]

  Runtime --> Cancel[Durable cancellation guard]
  Cancel --> Cancelled[CANCELLED]

  Analysis --> Recall[Advisory M10 memory recall]
  Recall --> Cache[TTL/LRU MemoryCache]
  Cache --> Search[Bounded hybrid search]
  Search --> Indexes[SQLite indexes + FTS5 candidates]
  Indexes --> Memory[SqliteMemoryStore]
  Memory --> ACL[Namespace ACL + provenance + sanitization]
  ACL --> Recall
  SwarmManager --> SwarmMemory[swarm:<id> learning observations]
  SwarmMemory --> Memory
  Federation --> FederationMemory[Federated task and node observations]
  FederationMemory --> ACL
  Evaluator --> Learning[Persistent Learning Engine]
  Learning --> Queue[Bounded async learning queue]
  Queue --> Batch[Transactional batch persistence]
  Batch --> Memory
  Learning --> Bonus[Bounded learning signal <= 10%]
  Bonus --> ExistingRouter[Existing AgentRouter]
  Selector --> ExistingRouter
  ExistingRouter --> AgentRegistry

  StepEvidence --> Events[Durable event store]
  SwarmManager --> Events
  Federation --> Events
  Events --> ReplayEvidence[Replay + restart recovery evidence]
  Runtime --> Telemetry[Traces + metrics + structured logs]

  Runtime --> Policy[Default-deny Policy + RBAC + Approvals]
  Policy -. guards .-> Validator
  Policy -. guards .-> Delegation
  Policy -. guards .-> Federation
  Policy -. guards .-> Workers
  Policy -. guards .-> SandboxManager
  Runtime --> Provider[Provider interface]
  Provider --> Models[Provider / model discovery]
  Runtime --> Knowledge[Local knowledge graph]

  Runtime --> MCP[M11/M12/M13/M14 MCP Server]
  MCP --> RegistryMCP[215 typed tool registry]
  RegistryMCP --> Families[21 capability families]
  MCP --> Resources[16 protected resources]
  MCP --> Prompts[12 policy-aware prompts]
  MCP --> Auth[Actor authorization + rate limits + audit]
  Auth --> Policy
  RegistryMCP --> McpAudit[Sanitized MCP audit log]
  McpAudit --> Events
  MCP --> Stdio[Official SDK stdio transport]
  MCP --> HTTP[Official SDK Streamable HTTP]
  Runtime --> Dashboard[Read-only dashboard]
